{
  "name": "shelsea-commerce",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "verify:support-live": "node scripts/verify-support-live-runtime.mjs",
    "verify:support-quick-chat": "node scripts/verify-quick-support-chat.mjs",
    "verify:support-quick-continuity": "node scripts/verify-quick-support-continuity.mjs",
    "verify:support-quick-unread": "node scripts/verify-quick-support-unread-state.mjs",
    "verify:support-quick-history": "node scripts/verify-quick-support-case-history.mjs",
    "verify:support-quick-production": "node scripts/verify-quick-support-production.mjs",
    "seed": "tsx prisma/seed.ts",
    "seed:admins": "tsx prisma/seed-admins.ts",
    "provision:super-admins": "tsx prisma/provision-super-admins.ts",
    "seed:production": "node --env-file=.vercel/.env.production.local ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "postinstall": "prisma generate",
    "dev:webpack": "next dev --webpack",
    "verify:support-knowledge-foundation": "node scripts/verify-support-knowledge-foundation.mjs",
    "verify:support-guide": "tsx scripts/verify-support-guide.ts",
    "verify:support-knowledge-runtime": "tsx scripts/verify-support-knowledge-runtime.ts",
    "verify:support-guide-context": "tsx scripts/verify-support-guide-context.ts",
    "verify:support-guide-handoff": "tsx scripts/verify-support-guide-handoff.ts",
    "verify:support-knowledge-studio": "tsx scripts/verify-support-knowledge-studio.ts",
    "verify:support-auto-response-production": "node scripts/verify-support-auto-response-production.mjs",
    "verify:support-auto-response-live-boundary": "node scripts/verify-support-auto-response-live-boundary.mjs",
    "verify:support-auto-response-release": "npm run verify:support-knowledge-runtime && npm run verify:support-guide && npm run verify:support-guide-context && npm run verify:support-guide-handoff && npm run verify:support-knowledge-studio && npm run typecheck && npm run lint && npm run verify:support-auto-response-production"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/prisma-adapter": "^1.6.23",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@vercel/blob": "^2.6.1",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "mapbox-gl": "^3.26.0",
    "maplibre-gl": "^6.0.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-easy-crop": "^6.2.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.8.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
