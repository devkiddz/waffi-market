# Paystack test mode only. Never expose this value through NEXT_PUBLIC_*.
PAYSTACK_SECRET_KEY="paystack_secret_key_goes_here"
# Optional. Paystack appends ?reference=... to this URL after checkout.
PAYSTACK_CALLBACK_URL="http://localhost:3000/payments"

# Transactional authentication email
# Waffi Market keeps this false during initial multivendor testing.
# When false, BetterAuth does not require vendor/customer email verification.
AUTH_EMAIL_ENABLED="false"
RESEND_API_KEY=""
# For local Resend testing, use the sender permitted by your Resend account.
# Production must use a sender on a verified domain.
AUTH_EMAIL_FROM="Waffi Market <auth@example.com>"
AUTH_EMAIL_REPLY_TO="support@example.com"

# Local multivendor testing only.
# All eight seeded test vendor owners use this shared local test password.
# Do not use a production password here and do not commit your real .env file.
