  summary    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime        @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_event")
