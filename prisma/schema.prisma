  synonyms        String[] @default([])
  requiredContext String[] @default([])

  conditions Json?
  actions    Json?

  status              SupportKnowledgeStatus @default(DRAFT)
  priority            Int                    @default(0)
  confidenceThreshold Float                  @default(0.65)
  version             Int                    @default(1)

  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questionExamples         SupportKnowledgeQuestionExample[]
  interactions             SupportKnowledgeInteraction[]
  supportKnowledgeBucket   SupportKnowledgeBucket?           @relation(fields: [supportKnowledgeBucketId], references: [id], onDelete: SetNull)
  supportKnowledgeBucketId String?

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, priority])
  @@index([workspaceId, intent, status])
  @@index([workspaceId, category, status])
  @@index([supportKnowledgeBucketId, priority])
  @@map("support_knowledge_entry")
}

model SupportKnowledgeQuestionExample {
  id String @id @default(cuid())

  entryId String
  entry   SupportKnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  text           String
  normalizedText String
  locale         String  @default("en-NG")
  weight         Float   @default(1)
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entryId, normalizedText])
  @@index([entryId, active])
  @@index([normalizedText])
  @@map("support_knowledge_question_example")
}

model SupportKnowledgeInteraction {
  id String @id @default(cuid())

  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId    String?
  supportCaseId String?

  entryId String?
  entry   SupportKnowledgeEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  question           String
  normalizedQuestion String
  matchedIntent      String?
  confidence         Float?
  outcome            SupportKnowledgeInteractionOutcome
  answer             String?

  feedbackHelpful Boolean?
  feedbackReason  String?
  humanRequested  Boolean  @default(false)

  pathname String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, outcome, createdAt])
  @@index([workspaceId, matchedIntent, createdAt])
  @@index([entryId, createdAt])
  @@index([customerId, createdAt])
  @@index([supportCaseId])
  @@map("support_knowledge_interaction")
}

// AJLOJIK_SUPPORT_KNOWLEDGE_END
