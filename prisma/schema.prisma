model AdminApprovalEvent {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  requestId String
  request   AdminApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

