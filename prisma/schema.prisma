  VENDOR
  INVENTORY
  WORKSPACE
  EXPERIENCE
  FEATURED_LAYOUT
  ORDER
  DELIVERY
  TRACKING_EVENT
  USER
  STAFF
  SHOPPING_LIST
  OTHER
}

enum AdminApprovalStatus {
