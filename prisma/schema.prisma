// ============================================================
// RCENTZ COMMUNICATION
// ============================================================

enum CommunicationConversationType {
  CUSTOMER_VENDOR
  SUPPORT_CASE
}

enum CommunicationConversationStatus {
  OPEN
  ARCHIVED
  CLOSED
  RESTRICTED
}

enum CommunicationParticipantRole {
  CUSTOMER
  VENDOR_MEMBER
  SUPPORT_AGENT
  ADMIN
  SYSTEM
}

enum CommunicationParticipantStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum CommunicationMessageType {
  TEXT
  SYSTEM
  EVENT
}

enum CommunicationAttachmentStatus {
  PENDING
  READY
  QUARANTINED
  REMOVED
}

model CommunicationConversation {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  type   CommunicationConversationType
  status CommunicationConversationStatus @default(OPEN)

  subject String?

  vendorProfileId String?
  vendorProfile   VendorProfile? @relation(fields: [vendorProfileId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CommunicationConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  dedupeKey String?
  metadata  Json?

  lastMessageAt DateTime?
  closedAt      DateTime?
  restrictedAt  DateTime?

  participants  CommunicationParticipant[]
  context       CommunicationContext?
  messages      CommunicationMessage[]
  statusHistory CommunicationStatusHistory[]
  supportCase   SupportCase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, type, updatedAt])
  @@index([vendorProfileId, status, lastMessageAt])
  @@index([createdById, createdAt])
  @@map("communication_conversation")
}

model CommunicationParticipant {
  id String @id @default(cuid())

  conversationId String
  conversation   CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  vendorProfileId String?
  vendorProfile   VendorProfile? @relation(fields: [vendorProfileId], references: [id], onDelete: SetNull)

  role   CommunicationParticipantRole
  status CommunicationParticipantStatus @default(ACTIVE)

  unreadCount Int       @default(0)
  lastReadAt  DateTime?
  mutedUntil  DateTime?
  archivedAt  DateTime?
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId, role])
  @@unique([conversationId, vendorProfileId, role])
  @@index([userId, status, updatedAt])
  @@index([vendorProfileId, status, updatedAt])
  @@index([conversationId, status])
  @@map("communication_participant")
}

model CommunicationContext {
  id String @id @default(cuid())

  conversationId String                    @unique
  conversation   CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  orderId String?
