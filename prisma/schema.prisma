  provider  String @default("paystack")
  reference String @unique

  amount Decimal       @db.Decimal(12, 2)
  status PaymentStatus @default(PENDING)

  paidAt   DateTime?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("payment")
}

