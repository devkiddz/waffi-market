model StaffProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  level        StaffLevel
  employeeCode String     @unique
  title        String?
  department   String?
  active       Boolean    @default(true)

  invitedById String?
  invitedBy   User?   @relation("StaffInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, level, active])
  @@map("staff_profile")
}

enum StaffLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

model AdminApprovalRequest {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  assignedReviewerId String?
  assignedReviewer   User?   @relation("ApprovalAssignedReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)

  source     AdminApprovalSource   @default(ADMIN)
  priority   AdminApprovalPriority @default(NORMAL)
  action     AdminApprovalAction
  targetType AdminTargetType
  targetId   String
  reason     String
  payload    Json?
  status     AdminApprovalStatus   @default(PENDING)

  reviewNote     String?
  internalNote   String?
  targetSnapshot Json?
  resultSnapshot Json?
  revision       Int     @default(1)

  dueAt               DateTime?
  holdUntil           DateTime?
  inspectionStartedAt DateTime?
  changesRequestedAt  DateTime?
  reviewedAt          DateTime?
  executedAt          DateTime?
  pausedAt            DateTime?
  reactivatedAt       DateTime?
  revertedAt          DateTime?
  expiredAt           DateTime?

  events AdminApprovalEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status, priority, createdAt])
  @@index([workspaceId, source, status, createdAt])
  @@index([assignedReviewerId, status, dueAt])
  @@index([requestedById, createdAt])
  @@index([targetType, targetId])
  @@map("admin_approval_request")
}

enum AdminApprovalAction {
  DELETE
  DELIVERY_STATUS_UPDATE
  DELIVERY_EXCEPTION
  PUBLISH_LIVE
  OTHER
}

enum AdminTargetType {
