// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTHENTICATION
// ============================================================

model User {
  storeStudioCampaigns StoreStudioCampaign[]
  uploadedMediaAssets  MediaAsset[]          @relation("MediaUploadedBy")
  ownedVendorProfiles  VendorProfile[]       @relation("VendorOwner")
  vendorMemberships    VendorMembership[]
  requestedVendorCategoryAccesses VendorCategoryAccess[]       @relation("VendorCategoryAccessRequester")
  reviewedVendorCategoryAccesses  VendorCategoryAccess[]       @relation("VendorCategoryAccessReviewer")
  submittedCatalogRequests        CatalogVocabularyRequest[]   @relation("CatalogVocabularyRequester")
  reviewedCatalogRequests         CatalogVocabularyRequest[]   @relation("CatalogVocabularyReviewer")
  id                   String                @id
  name                 String
  email                String
  emailVerified        Boolean               @default(false)
  image                String?
  tier                 String?               @default("member")
  accountState         String                @default("ACTIVE")
  lockedUntil          DateTime?
  restrictionReason    String?
  isGhostDeveloper     Boolean               @default(false)
  platformRole         PlatformRole          @default(STANDARD)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  sessions Session[]
  accounts Account[]

  experienceProfile ExperienceProfile?

  carts         Cart[]
  wishlists     Wishlist[]
  shoppingLists ShoppingList[]
  orders        Order[]
  addresses     Address[]
  reviews       Review[]

  recentlyViewed            RecentlyViewed[]
  workspaceMemberships      WorkspaceMembership[]
  demoWallets               DemoWallet[]
  experienceEvents          ExperienceEvent[]
  experienceHistoryEntries  ExperienceHistoryEntry[]
  experienceHistorySettings ExperienceHistorySettings[]

  staffProfile            StaffProfile?
  staffInvitations        StaffProfile[]           @relation("StaffInvitedBy")
  approvalRequests        AdminApprovalRequest[]   @relation("ApprovalRequestedBy")
  approvalReviews         AdminApprovalRequest[]   @relation("ApprovalReviewedBy")
  approvalAssignments     AdminApprovalRequest[]   @relation("ApprovalAssignedReviewer")
  approvalEvents          AdminApprovalEvent[]
  adminAuditEvents        AdminAuditEvent[]
  assignedAdminTodos      AdminTodo[]              @relation("AdminTodoAssignee")
  createdAdminTodos       AdminTodo[]              @relation("AdminTodoCreator")
  dispatchedDeliveries    Delivery[]               @relation("DeliveryDispatcher")
  deliveryEvents          DeliveryTrackingEvent[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationMutes       NotificationMute[]

  createdCommunicationConversations CommunicationConversation[]  @relation("CommunicationConversationCreator")
  communicationParticipants         CommunicationParticipant[]
  sentCommunicationMessages         CommunicationMessage[]       @relation("CommunicationMessageSender")
  uploadedCommunicationAttachments  CommunicationAttachment[]    @relation("CommunicationAttachmentUploader")
  communicationStatusChanges        CommunicationStatusHistory[] @relation("CommunicationStatusActor")

  customerSupportCases       SupportCase[]          @relation("SupportCaseCustomer")
  assignedSupportCases       SupportCase[]          @relation("SupportCaseAssignedAgent")
  supportAgentAssignments    SupportAssignment[]    @relation("SupportAssignmentAgent")
  createdSupportAssignments  SupportAssignment[]    @relation("SupportAssignmentAssigner")
  authoredSupportNotes       SupportNote[]          @relation("SupportNoteAuthor")
  supportEscalationActions   SupportEscalation[]    @relation("SupportEscalationActor")
  supportStatusChanges       SupportStatusHistory[] @relation("SupportStatusActor")
  proposedSupportResolutions SupportResolution[]    @relation("SupportResolutionProposer")
  approvedSupportResolutions SupportResolution[]    @relation("SupportResolutionApprover")
  supportFeedbackEntries     SupportFeedback[]
  supportLivePresenceRecords SupportLivePresence[]

  requestedSupportCommerceActions SupportCommerceAction[]          @relation("SupportCommerceActionRequester")
  approvedSupportCommerceActions  SupportCommerceAction[]          @relation("SupportCommerceActionApprover")
  executedSupportCommerceActions  SupportCommerceAction[]          @relation("SupportCommerceActionExecutor")
  shoppingListPreparationRequests ShoppingListPreparationRequest[] @relation("PreparationCustomer")

  assignedPreparationRequests ShoppingListPreparationRequest[] @relation("PreparationAssignedStaff")

  resolvedPreparationItems ShoppingListPreparationItem[] @relation("PreparationItemResolver")

  shoppingListPreparationEvents ShoppingListPreparationEvent[]

  aiAssistantSessions          AiAssistantSession[]         @relation("AiAssistantSessionUser")
  aiAssistantApplications      AiAssistantApplication[]     @relation("AiAssistantApplicationUser")
  ownedIntelligenceResolutions IntelligenceResolution[]     @relation("IntelligenceResolutionOwner")
  approvedIntelligenceActions  IntelligencePreparedAction[] @relation("IntelligencePreparedActionApprover")

  @@unique([email])
  @@index([accountState])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// EXPERIENCE PROFILE
// ============================================================

model ExperienceProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  persona String @default("new-member")

  preferredCategorySlugs String[] @default([])
  preferredBrandSlugs    String[] @default([])

  recentlyViewedProductIds String[] @default([])
  searchedTerms            String[] @default([])
  clickedCollectionIds     String[] @default([])

  recommendationScore Int @default(0)
  engagementScore     Int @default(0)
  commerceScore       Int @default(0)

  onboardingCompleted    Boolean @default(false)
  personalizationEnabled Boolean @default(true)

  experienceDensity     String  @default("immersive")
  autoplayPreviews      Boolean @default(true)
  discoveryEnabled      Boolean @default(true)
  recommendationMode    String  @default("balanced")
  shoppingNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("experience_profile")
}

// ============================================================
// MARKETPLACE TAXONOMY FOUNDATION
// ============================================================

model MarketplaceMarket {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  slug  String
  label String

  aliases String[] @default([])

  iconName    String?
  image       String?
  coverImages String[] @default([])

  shortDescription String?
  description      String?
  accentColor      String?

  active   Boolean @default(true)
  position Int     @default(0)

  vendorAssignments VendorMarketAssignment[]
  categories        Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, active, position])
  @@map("marketplace_market")
}

model VendorMarketAssignment {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  marketId String
  market   MarketplaceMarket @relation(fields: [marketId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  categoryAccesses VendorCategoryAccess[]

  active   Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorProfileId, marketId])
  @@unique([vendorProfileId, marketId, workspaceId])
  @@index([workspaceId, active])
  @@index([marketId, active])
  @@index([vendorProfileId, active])
  @@map("vendor_market_assignment")
}

enum CatalogAttributeValueMode {
  CONTROLLED
  TEXT
  NUMBER
  BOOLEAN
  MEASUREMENT
}

enum VendorCategoryAccessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CatalogVocabularyRequestType {
  CATEGORY
  SUBCATEGORY
  BRAND
  TAG
  ATTRIBUTE
  ATTRIBUTE_VALUE
}

enum CatalogVocabularyRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  MERGED
}

model CategoryBrandEligibility {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  brandId String
  brand   Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  active   Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, brandId])
  @@index([workspaceId, categoryId, active, position])
  @@index([workspaceId, brandId, active])
  @@map("category_brand_eligibility")
}

model CatalogTag {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  slug  String
  label String

  aliases     String[] @default([])
  description String?

  active   Boolean @default(true)
  position Int     @default(0)

  categoryEligibilities CategoryTagEligibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, active, position])
  @@map("catalog_tag")
}

model CategoryTagEligibility {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  tagId String
  tag   CatalogTag @relation(fields: [tagId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  active   Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, tagId])
  @@index([workspaceId, categoryId, active, position])
  @@index([workspaceId, tagId, active])
  @@map("category_tag_eligibility")
}

model CatalogAttribute {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  slug  String
  label String

  aliases String[] @default([])

  valueMode CatalogAttributeValueMode @default(CONTROLLED)
  unitFamily String?
  description String?

  active   Boolean @default(true)
  position Int     @default(0)

  values         CatalogAttributeValue[]
  categoryGuides CategoryAttributeGuide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, active, position])
  @@map("catalog_attribute")
}

model CatalogAttributeValue {
  id String @id @default(cuid())

  workspaceId String

  attributeId String
  attribute   CatalogAttribute @relation(fields: [attributeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  slug  String
  label String

  aliases String[] @default([])
  numericValue Decimal? @db.Decimal(18, 6)
  unit         String?
  colorHex     String?
  metadata     Json?

  active   Boolean @default(true)
  position Int     @default(0)

  categoryAllowances CategoryAttributeAllowedValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attributeId, slug])
  @@unique([id, attributeId, workspaceId])
  @@index([workspaceId, attributeId, active, position])
  @@map("catalog_attribute_value")
}

model CategoryAttributeGuide {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  attributeId String
  attribute   CatalogAttribute @relation(fields: [attributeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  required        Boolean @default(false)
  variantAxis     Boolean @default(false)
  filterable      Boolean @default(true)
  searchable      Boolean @default(true)
  customerVisible Boolean @default(true)
  vendorEditable  Boolean @default(true)
  allowCustomValue Boolean @default(false)
  position        Int     @default(0)

  allowedValues CategoryAttributeAllowedValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, attributeId])
  @@unique([categoryId, attributeId, workspaceId])
  @@index([workspaceId, categoryId, position])
  @@map("category_attribute_guide")
}

model CategoryAttributeAllowedValue {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  categoryId  String
  attributeId String
  guide       CategoryAttributeGuide @relation(fields: [categoryId, attributeId, workspaceId], references: [categoryId, attributeId, workspaceId], onDelete: Cascade)

  attributeValueId String
  attributeValue   CatalogAttributeValue @relation(fields: [attributeValueId, attributeId, workspaceId], references: [id, attributeId, workspaceId], onDelete: Cascade)

  active   Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, attributeValueId])
  @@index([workspaceId, categoryId, attributeId, active, position])
  @@map("category_attribute_allowed_value")
}

model VendorCategoryAccess {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  vendorProfileId String
  vendorProfile   VendorProfile @relation("VendorCategoryAccessVendor", fields: [vendorProfileId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  marketId         String
  marketAssignment VendorMarketAssignment @relation(fields: [vendorProfileId, marketId, workspaceId], references: [vendorProfileId, marketId, workspaceId], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId, marketId, workspaceId], references: [id, marketId, workspaceId], onDelete: Cascade)

  requestedByUserId String
  requestedBy       User @relation("VendorCategoryAccessRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  reviewedByUserId String?
  reviewedBy       User? @relation("VendorCategoryAccessReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  status     VendorCategoryAccessStatus @default(PENDING)
  reason     String?
  reviewNote String?

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  approvedAt  DateTime?
  suspendedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([vendorProfileId, categoryId])
  @@index([workspaceId, vendorProfileId, status])
  @@index([workspaceId, categoryId, status])
  @@map("vendor_category_access")
}

model CatalogVocabularyRequest {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  requestedByUserId String
  requestedBy       User @relation("CatalogVocabularyRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  reviewedByUserId String?
  reviewedBy       User? @relation("CatalogVocabularyReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  requestType CatalogVocabularyRequestType
  status      CatalogVocabularyRequestStatus @default(PENDING)

  requestedLabel       String
  requestedDescription String?
  reason               String?
  evidenceUrls         String[] @default([])
  context              Json?

  reviewNote       String?
  resolvedEntityId String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, vendorProfileId, status])
  @@index([workspaceId, requestType, status, submittedAt])
  @@map("catalog_vocabulary_request")
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id    String @id
  slug  String @unique
  label String

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  marketId String?
  market   MarketplaceMarket? @relation(fields: [marketId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  aliases String[] @default([])

  iconName    String?
  image       String?
  coverImages String[] @default([])

  shortDescription String?
  description      String?
  accentColor      String?
  className        String?

  active   Boolean @default(true)
  position Int     @default(0)

  subcategories        Subcategory[]
  products             Product[]
  brandEligibilities   CategoryBrandEligibility[]
  tagEligibilities     CategoryTagEligibility[]
  attributeGuides      CategoryAttributeGuide[]
  vendorAccesses       VendorCategoryAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, workspaceId])
  @@unique([id, marketId, workspaceId])
  @@index([workspaceId, marketId, active, position])
  @@index([active, position])
  @@map("category")
}

model Subcategory {
  id    String @id @default(cuid())
  slug  String
  label String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[]

  active   Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("subcategory")
}

model Brand {
  id   String @id @default(cuid())
  slug String @unique
  name String

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  parentBrandId String?
  parentBrand   Brand?  @relation("BrandHierarchy", fields: [parentBrandId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  childBrands   Brand[] @relation("BrandHierarchy")

  aliases String[] @default([])

  description String?
  logo        String?
  image       String?

  active   Boolean @default(true)
  position Int     @default(0)

  products             Product[]
  categoryEligibilities CategoryBrandEligibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId, active, position])
  @@index([parentBrandId])
  @@map("brand")
}

model Product {
  id   String @id
  slug String
  name String

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  shortDescription String?
  longDescription  String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  tags String[] @default([])

  rating       Float @default(0)
  reviewsCount Int   @default(0)
  soldCount    Int   @default(0)

  featured Boolean       @default(false)
  isNew    Boolean       @default(false)
  active   Boolean       @default(true)
  status   ProductStatus @default(PUBLISHED)

  vendorProfileId String?
  vendorProfile   VendorProfile? @relation(fields: [vendorProfileId], references: [id], onDelete: SetNull)

  submittedAt DateTime?
  approvedAt  DateTime?

  estimatedDelivery  String?
  discountPercentage Int     @default(0)

  variants ProductVariant[]
  images   ProductImage[]

  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  shoppingListItems ShoppingListItem[]
  orderItems        OrderItem[]
  recentlyViewedBy  RecentlyViewed[]
  reviews           Review[]

  promotionProducts  PromotionProduct[]
  collectionProducts StoreCollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preparationItems ShoppingListPreparationItem[]

  communicationContexts CommunicationContext[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, active])
  @@index([workspaceId, active, featured])
  @@index([workspaceId, active, isNew])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([brandId])
  @@index([vendorProfileId, status])
  @@map("product")
}

model ProductVariant {
  id    String @id
  label String

  color    String?
  colorHex String?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku   String? @unique
  image String?

  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  active   Boolean @default(true)
  position Int     @default(0)

  inventory         Inventory?
  cartItems         CartItem[]
  shoppingListItems ShoppingListItem[]
  orderItems        OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  originalPreparationItems ShoppingListPreparationItem[] @relation("PreparationOriginalVariant")

  resolvedPreparationItems ShoppingListPreparationItem[] @relation("PreparationResolvedVariant")

  @@index([productId])
  @@index([productId, active, position])
  @@index([mediaAssetId])
  @@map("product_variant")
}

model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url String
  alt String?

  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  position     Int         @default(0)
  primary      Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, position])
  @@index([mediaAssetId])
  @@map("product_image")
}

model Promotion {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  slug        String
  title       String
  description String?

  active   Boolean         @default(true)
  status   PromotionStatus @default(PUBLISHED)
  type     PromotionType   @default(PERCENTAGE)
  startsAt DateTime?
  endsAt   DateTime?
  priority Int             @default(0)

  discountValue Decimal? @db.Decimal(12, 2)
  usageLimit    Int?
  code          String?

  vendorProfileId String?
  vendorProfile   VendorProfile? @relation(fields: [vendorProfileId], references: [id], onDelete: SetNull)

  bannerMediaAssetId String?
  bannerMediaAsset   MediaAsset? @relation(fields: [bannerMediaAssetId], references: [id], onDelete: SetNull)

  products PromotionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId, active, priority])
  @@index([workspaceId, active, startsAt, endsAt])
  @@index([startsAt, endsAt])
  @@index([vendorProfileId, status])
  @@index([bannerMediaAssetId])
  @@map("promotion")
}

model PromotionProduct {
  id String @id @default(cuid())

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  discountPercentage Int?
  promotionalPrice   Decimal? @db.Decimal(12, 2)

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([promotionId, productId])
  @@index([productId])
  @@index([promotionId, position])
  @@map("promotion_product")
}

// ============================================================
// CART
// ============================================================

model Cart {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("cart")
}

model CartItem {
  id String @id @default(cuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_item")
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("wishlist")
}

model WishlistItem {
  id String @id @default(cuid())

  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_item")
}

// ============================================================
// CUSTOMER SHOPPING LISTS
// ============================================================

model ShoppingList {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?

  visibility ShoppingListVisibility @default(PRIVATE)
  status     ShoppingListStatus     @default(ACTIVE)

  publicationStatus      ShoppingListPublicationStatus @default(PRIVATE)
  publicationSubmittedAt DateTime?
  publicationReviewedAt  DateTime?
  publicationPublishedAt DateTime?
  publicationReviewNote  String?

  position Int @default(0)

  items ShoppingListItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preparationRequests ShoppingListPreparationRequest[]

  @@unique([workspaceId, userId, name])
  @@index([workspaceId, userId, status, updatedAt])
  @@index([workspaceId, visibility, publicationStatus, updatedAt])
  @@index([userId, updatedAt])
  @@map("shopping_list")
}

model ShoppingListItem {
  id String @id @default(cuid())

  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  quantity Int @default(1)
  position Int @default(0)

  note String?

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  preparationItems ShoppingListPreparationItem[]

  @@unique([shoppingListId, productId])
  @@index([shoppingListId, position])
  @@index([productId])
  @@index([variantId])
  @@map("shopping_list_item")
}

model StockMovement {
  id String @id @default(cuid())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  type      StockMovementType
  quantity  Int
  reason    String?
  reference String?

  createdAt DateTime @default(now())

  @@index([inventoryId])
  @@index([type])
  @@map("stock_movement")
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
  id String @id @default(cuid())

  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity     Int @default(0)
  reserved     Int @default(0)
  reorderLevel Int @default(5)

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory")
