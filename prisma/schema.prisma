  ON_HOLD
  CHANGES_REQUESTED
  APPROVED
  EXECUTED
  PAUSED
  REJECTED
  CANCELLED
  EXPIRED
  REVERTED
}

enum AdminApprovalSource {
  CUSTOMER
  VENDOR
  ADMIN
  SYSTEM
}

enum AdminApprovalPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AdminApprovalEventType {
  CREATED
  INSPECTION_STARTED
  ASSIGNED
  DEADLINE_CHANGED
  NOTE_UPDATED
  HELD
  REACTIVATED
  CHANGES_REQUESTED
  APPROVED
  EXECUTED
  PAUSED
  REJECTED
  CANCELLED
  EXPIRED
  REVERTED
