model Workspace {
  id   String @id @default(cuid())
  slug String @unique
  name String

  mode WorkspaceMode @default(LIVE)

  commerceMode           WorkspaceCommerceMode @default(SINGLE_MERCHANT)
  vendorApplicationsOpen Boolean               @default(false)
  currency               String                @default("NGN")
  timezone               String                @default("Africa/Lagos")
  defaultLowStockLevel   Int                   @default(5)
  mediaFolderPrefix      String?

  active     Boolean   @default(true)
  resettable Boolean   @default(false)
  expiresAt  DateTime?

  memberships               WorkspaceMembership[]
  demoWallets               DemoWallet[]
  events                    ExperienceEvent[]
  experienceHistoryEntries  ExperienceHistoryEntry[]
  experienceHistorySettings ExperienceHistorySettings[]
  provisions                DemoProvision[]

  carts         Cart[]
  wishlists     Wishlist[]
  shoppingLists ShoppingList[]
  orders        Order[]
  products      Product[]
  promotions    Promotion[]

  staffProfiles           StaffProfile[]
  approvalRequests        AdminApprovalRequest[]
  approvalEvents          AdminApprovalEvent[]
  adminAuditEvents        AdminAuditEvent[]
  adminTodos              AdminTodo[]
  deliveries              Delivery[]
  storefrontHero          StorefrontHero?
  storeStudioCampaigns    StoreStudioCampaign[]
  mediaAssets             MediaAsset[]
  vendors                 VendorProfile[]
  marketplaceMarkets      MarketplaceMarket[]
  vendorMarketAssignments VendorMarketAssignment[]
  categories                 Category[]
  brands                     Brand[]
  catalogTags                CatalogTag[]
  catalogAttributes          CatalogAttribute[]
  categoryBrandEligibilities CategoryBrandEligibility[]
  categoryTagEligibilities   CategoryTagEligibility[]
  categoryAttributeGuides    CategoryAttributeGuide[]
  categoryAttributeValues    CategoryAttributeAllowedValue[]
  vendorCategoryAccesses     VendorCategoryAccess[]
  catalogVocabularyRequests  CatalogVocabularyRequest[]
  storeCollections        StoreCollection[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationMutes       NotificationMute[]

  communicationConversations CommunicationConversation[]
  supportCases               SupportCase[]
  supportSLAs                SupportSLA[]
  supportKnowledgeBuckets    SupportKnowledgeBucket[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  shoppingListPreparationRequests ShoppingListPreparationRequest[]

  aiAssistantSessions      AiAssistantSession[]      @relation("AiAssistantSessionWorkspace")
  aiAssistantApplications  AiAssistantApplication[]  @relation("AiAssistantApplicationWorkspace")
  intelligenceResolutions  IntelligenceResolution[]  @relation("IntelligenceResolutionWorkspace")
  intelligenceProviderRuns IntelligenceProviderRun[] @relation("IntelligenceProviderRunWorkspace")
  intelligenceAuditEvents  IntelligenceAuditEvent[]  @relation("IntelligenceAuditEventWorkspace")

  // AJLOJIK_SUPPORT_KNOWLEDGE_RELATIONS
  supportKnowledgeEntries      SupportKnowledgeEntry[]
  supportKnowledgeInteractions SupportKnowledgeInteraction[]

  @@index([mode, active])
  @@map("workspace")
}

model StorefrontHero {
  id String @id @default(cuid())

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  enabled   Boolean @default(true)
  mediaType String  @default("VIDEO")
  mediaUrl  String? @default("https://www.youtube.com/watch?v=WN_fa23hasc")
  posterUrl String? @default("https://images.unsplash.com/photo-1575444758702-4a6b9222336e?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D")

  mediaAssetId String?
  mediaAsset   MediaAsset? @relation("StorefrontHeroMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  posterMediaAssetId String?
  posterMediaAsset   MediaAsset? @relation("StorefrontHeroPosterMedia", fields: [posterMediaAssetId], references: [id], onDelete: SetNull)

  eyebrow        String  @default("Your personal shopping experience")
  title          String  @default("Every beautiful moment starts here.")
  summary        String?
  primaryLabel   String  @default("Create your experience")
  primaryHref    String  @default("/sign-up")
  secondaryLabel String  @default("Sign in")
  secondaryHref  String  @default("/sign-in")
  autoplay       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mediaAssetId])
  @@index([posterMediaAssetId])
  @@map("storefront_hero")
}

